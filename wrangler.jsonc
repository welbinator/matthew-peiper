{
  "name": "matthew-peiper",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matthew-peiper-db",
      "database_id": "a9023dfe-09f5-4ada-8556-5c7ca855015a"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "210e2b2878544951a5c2df0acc2afd78"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SUPPORT_UPLOADS",
      "bucket_name": "matthew-peiper-support-uploads"
    }
  ],
  "assets": {
    "directory": "./dist"
  }
}
