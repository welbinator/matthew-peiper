---
import Base from "../layouts/Base.astro";
import Gallery from "../components/Gallery.astro";
import artwork from "../data/artwork.json";

const fineArt = artwork.pieces.filter((p) => p.category === "fine-art");
---

<Base
	title="Fine Art"
	description="Original fine art by Matthew Peiper — graphite studies and drawings available for purchase."
>
	<div class="artwork-page">
		<Gallery
			id="fine-art"
			sectionClass="fine-art"
			label="Originals"
			heading="Fine Art"
			pieces={fineArt}
		/>
	</div>
</Base>

<style>
	/* Push content below the fixed header on this non-hero page. */
	.artwork-page :global(section:first-child) { padding-top: 9rem; }
</style>

<script>
	const backdrop = document.createElement("div");
	backdrop.classList.add("art-modal-backdrop");
	backdrop.style.display = "none";
	document.body.appendChild(backdrop);

	const modals = Array.from(document.querySelectorAll<HTMLElement>(".art-modal"));
	modals.forEach((m) => document.body.appendChild(m));

	function openModal(modal: HTMLElement) {
		modal.classList.remove("art-modal--closing");
		modal.classList.add("art-modal--open");
		backdrop.style.display = "block";
		document.body.style.overflow = "hidden";
	}
	function closeModal(modal: HTMLElement) {
		modal.classList.remove("art-modal--open");
		modal.classList.add("art-modal--closing");
		setTimeout(() => {
			modal.classList.remove("art-modal--closing");
			backdrop.style.display = "none";
			document.body.style.overflow = "";
		}, 700);
	}

	document.querySelectorAll<HTMLElement>(".gallery-grid__item").forEach((item) => {
		const sel = item.getAttribute("data-modal-src");
		if (!sel) return;
		const modal = document.querySelector<HTMLElement>(sel);
		if (!modal) return;
		item.addEventListener("click", () => openModal(modal));
		modal.querySelector<HTMLButtonElement>(".art-modal__close")?.addEventListener("click", (e) => {
			e.stopPropagation();
			closeModal(modal);
		});
	});

	// ── Image carousels inside modals ──
	document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((car) => {
		const slides = Array.from(car.querySelectorAll<HTMLElement>(".art-carousel__slide"));
		const dots = Array.from(car.querySelectorAll<HTMLElement>("[data-carousel-dot]"));
		if (slides.length < 2) return;
		let cur = 0;
		const show = (n: number) => {
			cur = (n + slides.length) % slides.length;
			slides.forEach((s, i) => (s.hidden = i !== cur));
			dots.forEach((d, i) =>
				i === cur ? d.setAttribute("aria-current", "true") : d.removeAttribute("aria-current"),
			);
		};
		car.querySelector("[data-carousel-prev]")?.addEventListener("click", (e) => {
			e.stopPropagation();
			show(cur - 1);
		});
		car.querySelector("[data-carousel-next]")?.addEventListener("click", (e) => {
			e.stopPropagation();
			show(cur + 1);
		});
		dots.forEach((d, i) =>
			d.addEventListener("click", (e) => {
				e.stopPropagation();
				show(i);
			}),
		);
	});

	backdrop.addEventListener("click", () => {
		const open = document.querySelector<HTMLElement>(".art-modal--open");
		if (open) closeModal(open);
	});
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			const open = document.querySelector<HTMLElement>(".art-modal--open");
			if (open) closeModal(open);
		}
	});
</script>
