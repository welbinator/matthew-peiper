---
import { withBase } from "../lib/base";

interface Piece {
	slug: string;
	title: string;
	image: string;
	category: string;
	available: boolean;
}

interface Props {
	pieces: Piece[];
}

const { pieces } = Astro.props;
---

<div class="art-grid">
	{pieces.map((p) => (
		<figure class="art-card">
			<div class="art-thumb">
				<img
					src={withBase(`/images/${p.image}.webp`)}
					srcset={`${withBase(`/images/${p.image}-400.webp`)} 400w, ${withBase(`/images/${p.image}-800.webp`)} 800w, ${withBase(`/images/${p.image}.webp`)} 1200w`}
					sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 33vw"
					alt={p.title}
					loading="lazy"
					width="800"
					height="600"
				/>
			</div>
			<figcaption class="art-meta">
				<span class="art-title">{p.title}</span>
				<span class="art-status">
					{p.available ? "Available for purchase" : "Not currently available for purchase"}
				</span>
			</figcaption>
		</figure>
	))}
</div>

<style>
	.art-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: var(--spacing-xl);
	}
	.art-card {
		display: flex;
		flex-direction: column;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		overflow: hidden;
		transition: border-color var(--transition-base), transform var(--transition-base);
	}
	.art-card:hover {
		border-color: var(--color-brand);
		transform: translateY(-3px);
	}
	.art-thumb {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: #111;
	}
	.art-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform var(--transition-slow);
	}
	.art-card:hover .art-thumb img { transform: scale(1.04); }
	.art-meta {
		padding: var(--spacing-md) var(--spacing-lg) var(--spacing-lg);
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.art-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: 600;
		color: var(--color-text);
	}
	.art-status {
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-muted);
	}
</style>
